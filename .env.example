# Copiá este archivo como .env y completá los valores. NUNCA versiones .env.

# Proveedor de IA: anthropic | openai | mock
# "mock" permite correr todo el pipeline sin API key (salidas de prueba, no reales).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Base de datos. Por defecto SQLite local en data/senales.db
# Para migrar a PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/senales
DATABASE_URL=
